# ---------------------------------------------------------------------------
# Entra ID / MSAL public configuration — reference values only.
#
# This project uses Vite (see package.json / AUTH.md's "NPM/Vite
# alternative" section). Vite reads a file named exactly ".env" (copy this
# file to ".env" and fill in real values) at `npm run dev` / `npm run
# build` time, and exposes only VITE_-prefixed keys to browser code via
# `import.meta.env.VITE_*` in authConfig.js. The `VITE_` prefix is
# required by Vite itself — an unprefixed key is silently NOT exposed to
# the browser, so don't drop it.
#
# The values below are NOT secrets (Entra calls a SPA's client ID a
# "public client identifier" for exactly this reason) — Vite still inlines
# them as plain text into the built JS bundle; this is build-time
# templating for public values, not a secrets mechanism.
#
# NEVER add a client secret, certificate, or any confidential value to this
# file or any ".env*" file that ends up shipped to the browser. If a secret
# is ever genuinely required, it belongs in a backend's environment, not
# here — see AUTH.md, Section E.
# ---------------------------------------------------------------------------

# Application (client) ID from the Entra App Registration's Overview page.
# Feeds msalConfig.auth.clientId in authConfig.js.
VITE_MSAL_CLIENT_ID=

# Directory (tenant) ID from the same page.
# Feeds msalConfig.auth.authority (https://login.microsoftonline.com/<this>).
VITE_MSAL_TENANT_ID=

# Exact origin this site is served from (must match a registered SPA
# redirect URI in Entra — see AUTH.md Section A). Feeds
# msalConfig.auth.redirectUri / postLogoutRedirectUri. Leave unset to let
# authConfig.js derive it from window.location.origin at runtime instead.
VITE_MSAL_REDIRECT_URI=http://localhost:5500

# Optional app-level allow-list, comma-separated. This is a UI-only
# convenience gate — not a real security boundary, since anything shipped
# to the browser is always readable (see AUTH.md, Section E). Real access
# control still lives in Entra's "Assignment required" setting; this just
# lets you additionally narrow it down here without an Entra admin login.
# Leave unset/empty to allow anyone Entra itself lets through.
VITE_ALLOWED_EMAILS=user1@example.com,user2@example.com