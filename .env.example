# ---------------------------------------------------------------------------
# Entra ID / MSAL public configuration — reference values only.
#
# IMPORTANT — read before using this file:
# This app is plain HTML/CSS/JS with no build step, so nothing in the
# browser can read a ".env" file at runtime; browsers don't parse dotenv
# files, and there is no server here to inject these into a response.
# The values below are NOT secrets (Entra calls a SPA's client ID a
# "public client identifier" for exactly this reason) — they exist here
# only as a single documented reference point, e.g. for a CI/deploy script
# that copies them into authConfig.js, or for the optional npm/Vite setup
# described in AUTH.md, where Vite's `import.meta.env.VITE_*` mechanism
# does read a file shaped like this one at build time. The `VITE_MSAL_`
# prefix names these after the MSAL.js config fields they feed
# (msalConfig.auth.clientId / .authority / .redirectUri in authConfig.js),
# not after Entra ID generically — `VITE_` itself is required by Vite to
# expose a variable to browser code at all.
#
# For the default no-build setup in this repo: copy these three values
# directly into the `>>> REPLACE` markers near the top of authConfig.js
# instead of relying on this file being loaded automatically — it is NOT
# wired up to do that on its own without a bundler.
#
# NEVER add a client secret, certificate, or any confidential value to this
# file or any ".env*" file that ends up shipped to the browser. If a secret
# is ever genuinely required, it belongs in a backend's environment, not
# here — see AUTH.md, Section E.
# ---------------------------------------------------------------------------

# Application (client) ID from the Entra App Registration's Overview page.
# Feeds msalConfig.auth.clientId in authConfig.js.
VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID from the same page.
# Feeds msalConfig.auth.authority (https://login.microsoftonline.com/<this>).
VITE_MSAL_TENANT_ID=00000000-0000-0000-0000-000000000000

# Exact origin this site is served from (must match a registered SPA
# redirect URI in Entra — see AUTH.md Section A). Feeds
# msalConfig.auth.redirectUri / postLogoutRedirectUri. Leave unset to let
# authConfig.js derive it from window.location.origin at runtime instead.
VITE_MSAL_REDIRECT_URI=http://localhost:5500
