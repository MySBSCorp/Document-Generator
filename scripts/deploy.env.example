# ---------------------------------------------------------------------------
# Deploy target for scripts/deploy.sh. Copy to scripts/deploy.env and fill in.
#
#   cp scripts/deploy.env.example scripts/deploy.env
#
# scripts/deploy.env is gitignored. Nothing here is a secret in itself, but
# the SSH key path and hostname are per-developer, and .env files reliably
# accumulate real secrets over a project's life — so it stays untracked.
# ---------------------------------------------------------------------------

# Public DNS name or Elastic IP of the EC2 instance.
DEPLOY_HOST=docgen.mysbscorp.com

# Login user. "ec2-user" on Amazon Linux, "ubuntu" on Ubuntu AMIs.
DEPLOY_USER=ec2-user

# Path to the SSH private key (.pem) for the instance. Leave blank to use
# whatever your ~/.ssh/config or ssh-agent already resolves for this host.
DEPLOY_KEY=~/.ssh/sbscorp-ec2.pem

# SSH port. 22 unless your security group / sshd says otherwise.
DEPLOY_PORT=22

# Where releases live on the instance. Must match `root` in the nginx vhost
# (which points at $REMOTE_ROOT/current).
REMOTE_ROOT=/var/www/docgen

# Deployed URL, used only for the post-deploy health check. Leave blank to
# skip that check (e.g. before DNS or TLS is set up).
SITE_URL=https://docgen.mysbscorp.com

# How many timestamped releases to retain on the instance for rollback.
KEEP_RELEASES=5
